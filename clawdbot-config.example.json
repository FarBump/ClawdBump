{
  "agent": {
    "model": "google/gemini-1.5-flash",
    "workspace": "~/.clawdbot/workspace"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "textChunkLimit": 4000,
      "capabilities": {
        "inlineButtons": "all"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "0.0.0.0",
    "port": 18789
  }
}


