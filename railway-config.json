{
  "agent": {
    "model": "anthropic/claude-opus-4-5",
    "workspace": "/root/.clawdbot/workspace"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "${TELEGRAM_BOT_TOKEN}",
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "groupPolicy": "disabled",
      "textChunkLimit": 4000,
      "mediaMaxMb": 5,
      "timeoutSeconds": 500,
      "capabilities": {
        "inlineButtons": "all"
      },
      "commands": {
        "native": true
      },
      "replyToMode": "first",
      "streamMode": "partial"
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "0.0.0.0",
    "port": 18789,
    "auth": {
      "mode": "none"
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "tools": {
    "exec": {
      "enabled": true,
      "applyPatch": false
    }
  },
  "skills": {
    "enabled": true,
    "workspace": true,
    "managed": false,
    "bundled": false
  }
}
