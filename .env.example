# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=farbump_bot

# FarBump API Configuration
FARBUMP_API_URL=https://api.farbump.com
FARBUMP_API_KEY=your_farbump_api_key_here

# AI Model Configuration (choose one)
# Anthropic (recommended)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Or OpenAI
# OPENAI_API_KEY=sk-...

# Or Google Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=...

# Gateway Configuration
PORT=18789
NODE_ENV=production

# Optional: Redis for session storage (recommended for production)
# REDIS_URL=redis://localhost:6379

# Optional: Database URL for persistent storage
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
