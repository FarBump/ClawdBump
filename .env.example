# Telegram (required)
TELEGRAM_BOT_TOKEN=

# Gemini / Google AI (required)
GOOGLE_GENERATIVE_AI_API_KEY=

# ClawdBump backend (required for skills)
CLAWDBUMP_APP_URL=
CLAWDBUMP_BOT_SECRET=

# Railway sets this automatically
PORT=18789

# Optional: OpenClaw overrides
# OPENCLAW_AGENT_MODEL=google/gemini-2.5-flash-lite
# Di Railway: set NODE_VERSION=22.12 agar memenuhi syarat openclaw (>=22.12.0)
# NODE_VERSION=22.12

# Batas heap Node (MB); default 460 agar aman di container 512MB. Jika plan lebih besar, naikkan (mis. 768 atau 1024).
# NODE_OPTIONS=--max-old-space-size=460
